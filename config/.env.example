# Copy to the path named by "env_file" in config/local.json, outside the repo. Never commit real keys.
ELEVENLABS_API_KEY=
# Seedance (BytePlus ModelArk or a reseller such as fal.ai): see docs/PROVIDERS.md
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=
# Suno has no official public API: point this at the gateway you use (docs/PROVIDERS.md)
SUNO_API_KEY=
SUNO_BASE_URL=
# Any extra image/asset generator (the "generic_http" provider)
ASSETS_API_KEY=
ASSETS_BASE_URL=
FLORA_API_KEY=
# Google Gemini image models ("Nano Banana")
GEMINI_API_KEY=
